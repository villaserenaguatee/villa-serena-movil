{
  "expo": {
    "name": "Villa Serena",
    "slug": "villa-serena-movil",
    "version": "0.1.0",
    "scheme": "villaserena",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/villa-serena-logo.png",
    "newArchEnabled": true,
    "android": {
      "package": "gt.villaserena.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/villa-serena-logo.png",
        "backgroundColor": "#f8f6f0"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
